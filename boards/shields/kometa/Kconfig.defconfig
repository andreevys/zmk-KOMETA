if SHIELD_KOMETA_LEFT

config ZMK_KEYBOARD_NAME
    default "kometa"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_KOMETA_DONGLE

config ZMK_KEYBOARD_NAME
    default "kometa"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Both halves connect to the dongle as peripherals
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 5 host profiles + 2 peripherals
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif

if SHIELD_KOMETA_LEFT || SHIELD_KOMETA_RIGHT || SHIELD_KOMETA_DONGLE

config ZMK_SPLIT
    default y

config ZMK_BLE
    default y

endif
